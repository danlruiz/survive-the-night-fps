{
  "name": "survive-the-night-fps",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Co-op horror survival FPS - scavenge by day, board up wherever you stand by night, fix the car and escape. three.js client, authoritative Node uWebSockets.js server",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch-path=server --watch-path=shared server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "exec env NODE_ENV=production node server/index.js",
    "proxy": "exec env NODE_ENV=production node server/proxy/index.js",
    "migrate": "node scripts/migrate.js",
    "admin": "node scripts/set-admin.js",
    "setting": "node scripts/setting.js",
    "report": "node scripts/analytics-report.js",
    "check": "node scripts/check.js",
    "test": "node scripts/run-tests.js",
    "test:nightly": "node scripts/run-tests.js --nightly",
    "test:all": "node scripts/run-tests.js --all",
    "test:bots": "node scripts/bot.js 4 20",
    "bench:net": "node scripts/net-bench.js",
    "test:e2e": "node scripts/e2e-gameplay.js",
    "test:e2e:handoff": "node scripts/e2e-handoff.js",
    "test:e2e:pointer": "node scripts/e2e-pointer.js",
    "test:e2e:mobile": "node scripts/e2e-mobile.js",
    "test:e2e:cards": "node scripts/e2e-cards.js --live",
    "test:e2e:joinlock": "node scripts/e2e-joinlock.js",
    "test:cluster": "node scripts/test-cluster.js",
    "posttest": "node scripts/test-itemguide.js",
    "test:sim": "node scripts/sim-smoke.js",
    "stress": "node scripts/stress.js",
    "clip:survey": "node scripts/clip/survey.js",
    "clip:pairs": "node scripts/clip/pairs.js",
    "clip:game": "node scripts/clip/game-shots.js",
    "clip:fit": "node scripts/clip/fit-grip.js",
    "clip:props": "node scripts/clip/props.js",
    "clip:pickups": "node scripts/clip/pickups.js",
    "clip:outfits": "node scripts/clip/outfits.js",
    "hitbox:measure": "node scripts/hitbox/measure.js",
    "hitbox:overlay": "node scripts/hitbox/overlay.js",
    "hitbox:sweep": "node --max-old-space-size=8000 scripts/hitbox/sweep.js",
    "hitbox:fit": "node scripts/hitbox/fit.js",
    "perf:bench": "node scripts/perf/bench.js",
    "perf:visual": "node scripts/perf/visual.js",
    "perf:server": "node scripts/perf/server-bench.js",
    "perf:profile": "node scripts/perf/profile.js",
    "perf:report": "node scripts/perf/report.js"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "three": "^0.186.1",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.52.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.1"
  }
}
